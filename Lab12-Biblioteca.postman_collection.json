{
  "info": {
    "name": "Lab 12 - Biblioteca API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "authorId",
      "value": ""
    },
    {
      "key": "bookId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Laboratorio",
      "item": [
        {
          "name": "1. POST Crear autor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/authors",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gabriel García Márquez\",\n  \"email\": \"gabo@example.com\",\n  \"nationality\": \"Colombia\",\n  \"birthYear\": 1927,\n  \"bio\": \"Premio Nobel de Literatura 1982\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// guarda el id del autor para las siguientes peticiones",
                  "if (pm.response.code === 201) pm.collectionVariables.set('authorId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. GET Todos los autores",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/authors"
          }
        },
        {
          "name": "3. GET Autor por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/authors/{{authorId}}"
          }
        },
        {
          "name": "4. GET Libros de un autor",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/authors/{{authorId}}/books"
          }
        },
        {
          "name": "5. PUT Actualizar autor",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/authors/{{authorId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gabriel García Márquez\",\n  \"bio\": \"Autor de Cien años de soledad\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "6. POST Crear libro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/books",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cien años de soledad\",\n  \"description\": \"Obra maestra del realismo mágico\",\n  \"isbn\": \"978-0307474728\",\n  \"publishedYear\": 1967,\n  \"genre\": \"Novela\",\n  \"pages\": 417,\n  \"authorId\": \"{{authorId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// guarda el id del libro para las siguientes peticiones",
                  "if (pm.response.code === 201) pm.collectionVariables.set('bookId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "7. GET Todos los libros",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/books"
          }
        },
        {
          "name": "8. GET Libros por género",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/books?genre=Novela"
          }
        },
        {
          "name": "9. GET Libro por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/books/{{bookId}}"
          }
        },
        {
          "name": "10. DELETE Eliminar libro",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/books/{{bookId}}"
          }
        }
      ]
    },
