      ]
    },
    {
      "name": "Tarea",
      "item": [
        {
          "name": "T1. Búsqueda (ejemplo de la guía)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/books/search?search=amor&genre=Novela&page=1&limit=10&sortBy=publishedYear&order=desc"
          }
        },
        {
          "name": "T1. Búsqueda paginada (limit=2)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/books/search?page=1&limit=2&sortBy=title&order=asc"
          }
        },
        {
          "name": "T1. Búsqueda por nombre de autor",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/books/search?authorName=gabriel"
          }
        },
        {
          "name": "T2. Estadísticas del autor",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/authors/{{authorId}}/stats"
          }
        }
      ]
    }
  ]
}