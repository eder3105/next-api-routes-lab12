              "raw": "{\n  \"title\": \"Doce cuentos peregrinos\",\n  \"isbn\": \"978-1400034956\",\n  \"publishedYear\": 1992,\n  \"genre\": \"Cuento\",\n  \"pages\": 240,\n  \"authorId\": \"{{authorId}}\"\n}",
